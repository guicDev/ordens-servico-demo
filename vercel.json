{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/os",
      "destination": "/index.html"
    },
    {
      "source": "/precificacao",
      "destination": "/financeiro.html"
    },
    {
      "source": "/pagamentos",
      "destination": "/pagamentos-abertos.html"
    },
    {
      "source": "/contratos",
      "destination": "/contratos.html"
    },
    {
      "source": "/historico",
      "destination": "/historico.html"
    },
    {
      "source": "/estoque",
      "destination": "/estoque.html"
    },
    {
      "source": "/inconsistencias",
      "destination": "/inconsistencias.html"
    },
    {
      "source": "/inicio",
      "destination": "/index.html"
    },
    {
      "source": "/menu-principal",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
